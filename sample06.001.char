// 示例：多线程的基本方式

// 声明将在单独线程中执行的一个函数
// 函数可以带有输入参数
func1 := func(v0) {
	for i := 0; i < 5; i++ {
		v0++

		pl("(thread) v0=%v", v0)

		// sleep函数用于将当前线程休眠指定的秒数（可以是小数，例如1.2表示休眠1.2秒）
		sleep(1.0)
	}
}

// 声明一个全局变量 a
// 主线程和子线程将分别对该变量进行赋值，并输出该变量的值以便观察
a := 5

// 调用函数的 threadRun 方法，并传入参数（变量a）来启动一个线程
func1.threadRun(a)

sleep(0.15)

// 启动主线程
for i := 0; i < 5; i++ {
	a += 10

	pl("(main) a=%v", a)

	sleep(1.3)
}

// 运行后输出类似下面
//D:\tmp>char sample06.001.char
//(thread) v0=6
//(main) a=15
//(thread) v0=7
//(main) a=25
//(thread) v0=8
//(main) a=35
//(thread) v0=9
//(thread) v0=10
//(main) a=45
//(main) a=55

// 可以发现，子线程和主线程输出的两个值并无关联，这是因为
// 函数参数是传值而非传递引用，因此子线程中的 v0 ，与主线程的 a 已经是两个变量，只是初始值是当时a中的值（整数5）。

