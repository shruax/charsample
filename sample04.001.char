// 示例：函数的（输入）参数

// 声明一个带有参数的函数
f1 := func(a, b, c, d) {
	return a * b + c / d
}

// 调用该函数并传入参数获取输出结果
result1 := f1(3, 6, 8, 9)

pln("result1=", result1)

// 可变参数（函数接收不定个数的参数）
// 不定个数的参数前使用“...”来表示
// 函数的输入参数可以同时包括固定的参数和不定个数的参数，不定个数的参数必须是函数参数中的最后一个，且最多只能有一个
// 下面例子中，v0、v1均为固定参数，args为不定个数的参数
// 
f2 := func(v0, v1, ...args) {
	sum := v0 + v1

	// 可以用len内置函数来获取当次调用时不定个数参数的实际个数
	argsLen := len(args)

	// 不定个数参数的数据类型为数组，因此可以按数组进行枚举（遍历）
	for i := 0; i < argsLen; i++ {
		sum += args[i]
	}

	return sum
}

// 不定个数参数的数据类型可以不同
result2 := f2(3, 6, 8, 9.5, 7)

pln("result2=", result2)
