// 示例：多线程中传递共享参数
// 本例中的方法是使用内置函数 new 来创建引用型变量
// 引用型变量通过 unref 内置函数来取值，通过 setValueByRef 内置函数来赋值
// 通过给子线程函数传递引用性变量，即可实现线程间共享一个变量

// 循环20轮
roundsT := 20

func1 := func(v0) {

	for i := 0; i < roundsT; i++ {
		setValueByRef(v0, unref(v0)+1)

		pl("(thread) *v0=%v", unref(v0))

		sleep(0.05)
	}
}

// new 函数的第一个参数是一个数据类型名，第二个是给其赋予的初值
a := new("int", 5)

func1.threadRun(a)

sleep(0.15)

for i := 0; i < roundsT; i++ {
	setValueByRef(a, unref(a)+10)

	pl("(main) *a=%v", unref(a))

	sleep(0.065)
}

// 本例的运行结果类似下面（将无限循环，按Ctrl-C退出）：

//(thread) *v0=6
//(thread) *v0=7
//(thread) *v0=8
//(main) *a=18
//(thread) *v0=19
//(thread) *v0=20
//(main) *a=30
//(thread) *v0=31
//(main) *a=41
//(thread) *v0=42
//(main) *a=52
//(thread) *v0=53
//(thread) *v0=54
//(main) *a=64

// 可以看出，子线程与主线程修改的同一个变量值，实现了数值的联动

